# ─────────────────────────────────────────────────────────────────────────────
# WHOOP API credentials
# 1. Go to https://developer.whoop.com/
# 2. Create an application
# 3. Set the redirect URI to:  http://localhost:5000/auth/whoop/callback
# 4. Copy your Client ID and Client Secret below
# ─────────────────────────────────────────────────────────────────────────────
WHOOP_CLIENT_ID=paste_your_whoop_client_id_here
WHOOP_CLIENT_SECRET=paste_your_whoop_client_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# STRAVA API credentials
# 1. Go to https://www.strava.com/settings/api
# 2. Create an application
# 3. Set the "Authorization Callback Domain" to:  localhost
# 4. Copy your Client ID and Client Secret below
# ─────────────────────────────────────────────────────────────────────────────
STRAVA_CLIENT_ID=paste_your_strava_client_id_here
STRAVA_CLIENT_SECRET=paste_your_strava_client_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic / Claude API key
# 1. Go to https://console.anthropic.com/
# 2. Create an API key
# 3. Paste it below
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=paste_your_anthropic_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Flask settings — run this once to generate a secret key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Paste the output below.
# ─────────────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change_this_to_a_long_random_string

# Port the dashboard runs on (default is fine)
FLASK_PORT=5000
